{
	servers {
		trusted_proxies static private_ranges
	}
}

# ":80" while traffic arrives through the tunnel. With a domain, set SITE_ADDRESS
# to "http://gold.example.com" behind a named tunnel, or to "gold.example.com"
# (and publish ports 80 and 443) to let Caddy terminate TLS itself.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	reverse_proxy app:4317 {
		# Only safe while Cloudflare is the sole way in; otherwise a client could set it.
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}
