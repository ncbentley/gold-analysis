{
	servers {
		trusted_proxies static private_ranges
	}
}

# The named tunnel speaks HTTP to this container. SITE_ADDRESS is
# http://goldintelligencegateway.com in production. ":80" remains the fallback
# for a quick tunnel. www redirects to the apex.
http://www.goldintelligencegateway.com {
	redir https://goldintelligencegateway.com{uri} permanent
}

{$SITE_ADDRESS::80} {
	@feed path /api/feed/stream
	handle @feed {
		reverse_proxy app:4317 {
			flush_interval -1
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy app:4317 {
			# Only safe while Cloudflare is the sole way in; otherwise a client could set it.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
}
