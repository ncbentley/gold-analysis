# Copy to deploy/.env on the server (chmod 600). Never commit the real file.

# Encrypts the Telegram session and API keys stored in the database. Keep it
# stable: changing it means signing in to Telegram again.
APP_SECRET=
POSTGRES_PASSWORD=
# Public address, used in emails and Stripe redirects. deploy.sh keeps it in
# step with the quick tunnel's address.
APP_URL=

# Used only when the database is empty. 12+ characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Shared secret for POST /api/v1/ingest/:slug.
INGEST_TOKEN=

# Fallbacks for /admin/settings.
MARKET_DATA_PROVIDER=twelvedata
TWELVEDATA_API_KEY=
AI_PROVIDER=deepinfra
DEEPINFRA_API_KEY=

# Once a domain is on Cloudflare: create a named tunnel, point its public
# hostname at http://caddy:80, then set these two and redeploy.
# TUNNEL_COMMAND=tunnel --no-autoupdate run
# TUNNEL_TOKEN=
# SITE_ADDRESS=http://gold.example.com
