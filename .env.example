# Copy to .env.local. Every variable is optional for local development:
# with nothing set the app uses embedded Postgres, synthetic market data, a mock
# AI analyst and test-mode billing. Telegram is configured in the admin
# (/admin/telegram), not here.
#
# Production values are not stored in this file. They live in Infisical
# (https://vault.mountainwest.digital), project Gold Intelligence Gateway,
# environment prod. See README.md.

# --- App -----------------------------------------------------------------
# Public base URL, used in emails and Stripe redirect URLs.
APP_URL=http://localhost:4317
# Encrypts credentials entered in the admin (Telegram session, API keys).
# Required in production. In development a random key is created in
# .data/app-secret. Changing it makes stored credentials unreadable, so you
# would need to sign in to Telegram again.
# APP_SECRET=

# --- Database --------------------------------------------------------------
# Postgres connection string. When unset, an embedded PGlite database is used.
# DATABASE_URL=postgres://user:pass@localhost:5432/gold_signals
# PGlite data directory (ignored when DATABASE_URL is set). "memory://" for tests.
PGLITE_DATA_DIR=.data/pglite

# --- Seed (pnpm db:setup / db:reset) ------------------------------------------
# The seed creates plans, tier entitlements and this admin account only.
# In production the password must be set and at least 12 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
# Set to 1 to also create free@/silver@/gold@/platinum@example.com
# (password demo12345) for checking what each tier sees.
# SEED_DEMO_USERS=1

# --- Webhook ingestion (secondary to Telegram) ---------------------------------
# Shared secret for POST /api/v1/ingest/:slug (x-ingest-token header or Bearer).
# Defaults to "dev-ingest-token" outside production; required in production.
# INGEST_TOKEN=

# --- Market data -------------------------------------------------------------
# Usually set in /admin/settings, which takes precedence over these.
# "mock" (synthetic XAU/USD, development only) or "twelvedata" (real prices).
# MARKET_DATA_PROVIDER=twelvedata
# TWELVEDATA_API_KEY=

# --- AI ----------------------------------------------------------------------
# "mock" (default, no network), "deepinfra", "cloudflare", or "openai".
# Leave unset to use whichever key is present, in that order.
# Queue review uses the same choice. The cheap DeepInfra default is
# meta-llama/Meta-Llama-3.1-8B-Instruct. Do not commit a key.
AI_PROVIDER=mock
# DEEPINFRA_API_KEY=
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
# Prompt version for new signal analyses: signal-setup-v1 | signal-setup-v2
# AI_SIGNAL_PROMPT_VERSION=signal-setup-v1

# --- Billing -----------------------------------------------------------------
# When STRIPE_SECRET_KEY is unset, billing runs in test mode (mock checkout).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price ids, one per tier and period:
# STRIPE_PRICE_SILVER_WEEKLY=
# STRIPE_PRICE_SILVER_MONTHLY=
# STRIPE_PRICE_SILVER_ANNUAL=
# STRIPE_PRICE_GOLD_WEEKLY=
# STRIPE_PRICE_GOLD_MONTHLY=
# STRIPE_PRICE_GOLD_ANNUAL=
# STRIPE_PRICE_PLATINUM_WEEKLY=
# STRIPE_PRICE_PLATINUM_MONTHLY=
# STRIPE_PRICE_PLATINUM_ANNUAL=

# --- Product analytics -------------------------------------------------------
# PostHog project API key. Unset skips forwarding. Product events still land in Postgres. Page views and revenue are sent only to PostHog.
# POSTHOG_API_KEY=
# US cloud is the default. EU cloud is https://eu.i.posthog.com
# POSTHOG_HOST=https://us.i.posthog.com

# --- Email and background work ----------------------------------------------
# Sends verification and password-reset mail through Resend. Without a key,
# mail is stored in the dev mailbox instead. The default sender is Resend's
# shared test address, which only delivers to the Resend account email.
# Set EMAIL_FROM to a verified domain once DNS is in place.
# RESEND_API_KEY=
# EMAIL_FROM=Gold Intelligence Gateway <onboarding@resend.dev>
# Show the dev mailbox link (verification / reset emails) in production builds.
# Ignored while RESEND_API_KEY is set.
# DEV_MAILBOX=1
# Set to "off" on the web app when the queue service runs the jobs.
# The Docker stack does this. Jobs stay in Postgres, so an app restart
# does not drop them.
# JOBS_WORKER=off
# QUEUE_URL=http://queue:4320
# QUEUE_PORT=4320
# Comma-separated job types this process claims. Unset claims every type,
# each on its own lane. Keep Telegram in the same process as PROCESS_EVENT.
# WORKER_TYPES=PROCESS_EVENT,TELEGRAM_SYNC
# Postgres pool size for the queue lanes. Default 30.
# PG_POOL_MAX=30
